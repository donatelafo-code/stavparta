# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite & Uploads storage paths
DATA_DIR="./data"
UPLOAD_DIR="./uploads"

# Admin Authentication: Initial password for bootstrapping the 'admin' account on first start.
# Must be changed after first login. Leave empty to use the one-time first-run setup UI.
ADMIN_INITIAL_PASSWORD=""
# Optional secret pepper used to HMAC-hash admin session tokens in SQLite.
SESSION_SECRET=""

# SMTP Email Notifications (optional - logs warning if omitted)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="STAVPARTA Web <poptavky@stavparta.cz>"
NOTIFY_EMAIL=""

# Telegram Bot Notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
